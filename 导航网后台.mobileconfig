<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ============================================ -->
    <!-- 以下 6 项 不 用 改 ，直接复制就行              -->
    <!-- ============================================ -->

    <!-- 安装时显示的描述文件名称 -->
    <key>PayloadDisplayName</key>
    <string>导航网管理页面</string>

    <!-- 安装时显示的详细描述 -->
    <key>PayloadDescription</key>
    <string>点击安装后，可以更方便的管理导航网</string>

    <!-- 描述文件唯一标识（不用改） -->
    <key>PayloadIdentifier</key>
    <string>com.yourcompany.website.installer</string>

    <!-- 显示的组织名称 -->
    <key>PayloadOrganization</key>
    <string>花傲天传媒</string>

    <!-- 配置类型（固定值） -->
    <key>PayloadType</key>
    <string>Configuration</string>

    <!-- 描述文件唯一UUID（不用改） -->
    <key>PayloadUUID</key>
    <string>9A8B7C6D-5E4F-3A2B-1C0D-9E8F7A6B5C4D</string>

    <!-- 配置文件版本（固定值） -->
    <key>PayloadVersion</key>
    <integer>1</integer>


    <!-- ============================================ -->
    <!-- WebClip 核心配置（下面才是要改的地方）        -->
    <!-- ============================================ -->

    <key>PayloadContent</key>
    <array>
        <dict>

            <!-- 以下 4 项 不 用 改 -->
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>

            <key>PayloadIdentifier</key>
            <string>com.yourcompany.website.webclip</string>

            <key>PayloadUUID</key>
            <string>E5F4A3B2-C1D0-4E5F-A6B7-C8D9E0F1A2B3</string>

            <key>PayloadVersion</key>
            <integer>1</integer>


            <!-- ======================================== -->
            <!-- ⭐ 第 1 处要改：桌面图标名称              -->
            <!-- 建议 4-6 个中文字，不要太长               -->
            <!-- ======================================== -->
            <key>Label</key>
            <string>导航网后台</string>   <!-- 把"我的网站"改成你想要的名称 -->


            <!-- ======================================== -->
            <!-- ⭐ 第 2 处要改：你的网站网址              -->
            <!-- 把 GitHub Pages 网址填进去               -->
            <!-- ======================================== -->
            <key>URL</key>
            <string>https://hatdhw0001.github.io/045/</string>   <!-- 替换成你的网址 -->


            <!-- ======================================== -->
            <!-- true=全屏隐藏地址栏 / false=显示地址栏    -->
            <!-- 建议保持 true，更像 App                   -->
            <!-- ======================================== -->
            <key>FullScreen</key>
            <true/>   <!-- 这个不用改 -->


            <!-- ======================================== -->
            <!-- ⭐ 第 3 处要改：图标 Base64 编码          -->
            <!-- 把下面 <data> 里的内容替换成你的图标数据   -->
            <!-- 如果暂时没有图标，保留下面示例也可以       -->
            <!-- ======================================== -->
            <key>Icon</key>
            <data>
               <!-- 替换成你的 Base64 字符串 -->
            </data>


            <!-- ======================================== -->
            <!-- 是否允许用户卸载（true=允许）             -->
            <!-- 这个不用改                               -->
            <!-- ======================================== -->
            <key>IsRemovable</key>
            <true/>

        </dict>
    </array>

</dict>
</plist>